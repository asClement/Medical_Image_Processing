@startuml class_diagram_core
!pragma layout smetana
!theme plain
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classStereotypeIcon false
skinparam linetype ortho
hide circle

title "Medical Image Processing — dépendances entre modules"

package "medio" as MEDIO
package "denoise" as DENOISE
package "edges" as EDGES
package "preprocessing" as PREPROC
package "mathmorpho" as MATH
package "segmed3d" as SEG
package "segmed3d.utils" as SEGUTILS
package "utils" as DATAUTILS

DENOISE ..> MEDIO : MedicalImage3D
EDGES ..> MEDIO : MedicalImage3D
PREPROC ..> "NiBabel / SimpleITK"
MATH ..> "NiBabel / SciPy / scikit-image"
DATAUTILS ..> "TCIA / NBIA"
DATAUTILS ..> "DICOM / NiBabel / dicom2nifti"

@enduml
