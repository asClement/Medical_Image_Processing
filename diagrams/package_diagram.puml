@startuml package_diagram
!pragma layout smetana
!theme plain
left to right direction
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam componentStyle rectangle
skinparam linetype ortho

title "Medical Image Processing — architecture des packages"

package "medio" as MEDIO
package "denoise" as DENOISE
package "edges" as EDGES
package "preprocessing" as PREPROC
package "mathmorpho" as MATH
package "segmed3d" as SEG
package "segmed3d.utils" as SEGUTILS
package "utils" as DATAUTILS
component "DIPY / SciPy / SimpleITK" as DENOISE_LIB
component "scikit-image / SciPy" as EDGES_LIB
component "NiBabel / SimpleITK / scikit-image" as PREPROC_LIB
component "NiBabel / SciPy / scikit-image" as MATH_LIB
component "SciPy / scikit-image / SimpleITK / scikit-learn" as SEG_LIB
component "NiBabel / SciPy / scikit-image" as SEGUTILS_LIB
component "TCIA / NBIA" as TCIA_LIB
component "DICOM / NiBabel / dicom2nifti" as DATA_LIB

DENOISE --> MEDIO
EDGES --> MEDIO
DENOISE --> DENOISE_LIB
EDGES --> EDGES_LIB
PREPROC --> PREPROC_LIB
MATH --> MATH_LIB
SEG --> SEG_LIB
SEGUTILS --> SEGUTILS_LIB
DATAUTILS --> TCIA_LIB
DATAUTILS --> DATA_LIB
@enduml
