@startuml class_diagram_morphology_analysis
!pragma layout smetana
!theme plain
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classStereotypeIcon false
skinparam linetype ortho
hide circle

title "Vue fonctionnelle — morphologie et analyse de forme"

package "Transformations morphologiques" {
  class MathMorphology {
    + dilatation(...): np.ndarray
    + erosion(...): np.ndarray
    + ouverture(...): np.ndarray
    + fermeture(...): np.ndarray
    + reconstruction(...): np.ndarray
    + gradient_morphologique(...): np.ndarray
    + erosion_geodesique(...): np.ndarray
  }
  class MorphologyEnhancement {
    + top_hat_blanc(...): np.ndarray
    + top_hat_noir(...): np.ndarray
  }
}

package "Nettoyage et topologie" {
  class MorphologyCleaning {
    + supprimer_petits_objets(...): np.ndarray
    + supprimer_petits_trous(...): np.ndarray
    + etiqueter_composantes(...): tuple
    + garder_plus_grande_composante(...): np.ndarray
  }
  class MorphologySkeleton {
    + squelettiser(): np.ndarray
    + axe_median(): tuple
  }
  class DistanceTransform {
    + transformee_distance(...): np.ndarray
  }
}

package "Mesures" {
  class MorphologyShape {
    + enveloppe_convexe(): np.ndarray
    + indice_convexite(): float
  }
  class MorphologyStats {
    + resume(): dict
    + rapport_complet(...): dict
    + afficher_resume(): None
    + histogramme_intensites(...)
    + histogramme_volume_comparatif()
    + afficher_coupes(...)
  }
}

MathMorphology ..> "scikit-image" : opérations morphologiques
MorphologyEnhancement ..> "scikit-image" : top-hat
MorphologyCleaning ..> "scikit-image" : nettoyage / composantes
MorphologySkeleton ..> "scikit-image" : squelette / axe médian
MorphologyShape ..> "scikit-image" : enveloppe convexe
MorphologyStats ..> "SciPy / Matplotlib" : statistiques / figures
DistanceTransform ..> "SciPy" : transformée de distance
@enduml
