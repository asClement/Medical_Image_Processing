@startuml class_diagram_segmentation_evaluation
!pragma layout smetana
!theme plain
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classStereotypeIcon false
skinparam linetype ortho
hide circle

title "Vue fonctionnelle — segmentation et évaluation"

abstract class BaseSegmentation {
  + volume_: np.ndarray
  + affine_: np.ndarray
  + mask_: np.ndarray | None
  {abstract} + fit(...): BaseSegmentation
  + get_mask(): np.ndarray
  + save(path): str
  + __call__(...): np.ndarray
}

package "Méthodes de segmentation" {
  class ThresholdSegmentation
  class WatershedSegmentation
  class ActiveContourSegmentation
  class LevelSetSegmentation
  class RegionGrowingSegmentation
  class ClusteringSegmentation
  class AtlasSegmentation
}

package "Préparation du masque" {
  class Postprocessor <<utility>> {
    + clean_mask(...): np.ndarray
    + remove_small_objects(...): np.ndarray
    + largest_cc(...): np.ndarray
    + fill_holes(...): np.ndarray
  }
}

package "Évaluation et visualisation" {
  class Metrics <<utility>> {
    + dice(...): float
    + iou(...): float
    + sensitivity(...): float
    + specificity(...): float
    + precision(...): float
    + hausdorff95(...): float
    + volume_similarity(...): float
    + all_metrics(...): dict
  }
  class Visualizer <<utility>> {
    + plot_3d_slices(...): Figure
    + plot_overlay(...): Figure
    + plot_3d_surface(...): Figure
    + plot_histogram(...): Figure
  }
}

BaseSegmentation <|-- ThresholdSegmentation
BaseSegmentation <|-- WatershedSegmentation
BaseSegmentation <|-- ActiveContourSegmentation
BaseSegmentation <|-- LevelSetSegmentation
BaseSegmentation <|-- RegionGrowingSegmentation
BaseSegmentation <|-- ClusteringSegmentation
BaseSegmentation <|-- AtlasSegmentation
AtlasSegmentation ..> "SimpleITK" : registration / STAPLE
ClusteringSegmentation ..> "scikit-learn" : K-Means
ClusteringSegmentation ..> "scikit-fuzzy" : Fuzzy C-Means (optionnel)
@enduml
